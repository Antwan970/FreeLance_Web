MONGODB_URI=mongodb://localhost:27017/jobportal
JWT_SECRET=your_secret_key
PORT=5001

# Use console for local development or smtp for real email delivery.
EMAIL_DELIVERY=console

# Email settings used for accepted/rejected application notifications when EMAIL_DELIVERY=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="FreeLance Team <no-reply@example.com>"
